# Environment Variables for AI Life Coach Brain

# ===========================================
# LLM PROVIDER SELECTION
# ===========================================
# Options: openrouter (FREE), gemini (FREE), ollama (local), openai (paid)
LLM_PROVIDER=openrouter

# ===========================================
# OPENROUTER (RECOMMENDED - FREE MODELS)
# ===========================================
# Get your API key at: https://openrouter.ai/keys
# Free models: deepseek/deepseek-r1:free, meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=deepseek/deepseek-r1:free

# ===========================================
# GOOGLE GEMINI (FREE $300 CREDIT)
# ===========================================
# Get your free API key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key

# ===========================================
# OPENAI (FOR EMBEDDINGS + FALLBACK)
# ===========================================
# Required for embeddings (text-embedding-3-small)
# Also works with OpenRouter if you put OpenRouter key here
OPENAI_API_KEY=your_openai_or_openrouter_api_key

# ===========================================
# OLLAMA (LOCAL - FREE)
# ===========================================
# Run: ollama run deepseek-r1:latest
OLLAMA_BASE_URL=http://localhost:11434

# ===========================================
# SUPABASE (DATABASE)
# ===========================================
# Get from: https://supabase.com/dashboard
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
