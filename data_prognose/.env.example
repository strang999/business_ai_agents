# Environment Variables for Trading Agent

# OpenRouter API Key (for DeepSeek/LLMs)
OPENAI_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Optional: For production features
# CCXT_API_KEY=your-exchange-api-key
# CCXT_API_SECRET=your-exchange-api-secret

# Optional: For news/sentiment
# NEWS_API_KEY=your-newsapi-key
# ALPHA_VANTAGE_KEY=your-alpha-vantage-key

# Optional: For TimeGPT
# NIXTLA_API_KEY=your-nixtla-api-key
